// shared version block; define VER_DESC and VER_ORIGNAME before including
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,1,0
 PRODUCTVERSION 1,2,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sallador"
            VALUE "FileDescription", VER_DESC
            VALUE "FileVersion", "1.2.1.0"
            VALUE "InternalName", "Noctis"
            VALUE "LegalCopyright", "(c) 2026 Sallador"
            VALUE "OriginalFilename", VER_ORIGNAME
            VALUE "ProductName", "Noctis"
            VALUE "ProductVersion", "1.2.1.0"
            VALUE "Comments", "Developer: Sallador"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
